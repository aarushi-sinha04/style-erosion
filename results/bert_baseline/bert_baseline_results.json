{
  "model": "BERT Siamese (bert-base-uncased)",
  "architecture": {
    "encoder": "bert-base-uncased (768-dim [CLS])",
    "frozen_layers": 2,
    "interaction": "[u, v, |u-v|, u*v] \u2192 3072-dim",
    "head": "3072 \u2192 512 \u2192 128 \u2192 1"
  },
  "training": {
    "dataset": "PAN22 + Blog + Enron",
    "max_pairs_per_domain": 400,
    "epochs": 5,
    "batch_size": 4,
    "lr": 2e-05,
    "max_len": 256
  },
  "results": {
